# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8003

# Comma-separated browser origins allowed to call this API. app.js additionally
# accepts any loopback/private-LAN origin on FRONTEND_PORT outside production,
# so a changed DHCP address needs no edit here.
CORS_ORIGIN=http://localhost:3003
FRONTEND_PORT=3003

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_DIALECT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5435
DATABASE_NAME=joineazy_placement
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres123

# Schema handling at boot: safe | none | alter
#   safe  — create missing tables only (default in development)
#   none  — connect only (default in production)
#   alter — reconcile existing tables; prefer `npm run db:migrate`
DB_SYNC=safe

# SSL to Postgres: "true" | "false". Defaults to NODE_ENV==production when unset.
# Set false for a local/Docker Postgres, which does not offer SSL.
DATABASE_SSL=false

# ─── JWT ──────────────────────────────────────────────────────────────────────
# MUST match the main ERP's JWT_SECRET — this service verifies tokens it issues
# and does not own user accounts.
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

LOG_LEVEL=info
